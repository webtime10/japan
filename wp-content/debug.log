u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0444\u043e\u043d \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u043e\u0442\u0434\u044b\u0445\u0430. \u0417\u0434\u0435\u0441\u044c \u0441\u0435\u043c\u044c\u0438 \u0441 \u0434\u0435\u0442\u044c\u043c\u0438 \u043d\u0430\u0439\u0434\u0443\u0442 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0432\u043a\u0443\u0441: \u043e\u0442 \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043e\u0442\u0434\u044b\u0445\u0430 \u043d\u0430 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \u043f\u043b\u044f\u0436\u0430\u0445 \u0438 \u0432\u043e\u0434\u043d\u044b\u0445 \u0432\u0438\u0434\u043e\u0432 \u0441\u043f\u043e\u0440\u0442\u0430 \u0434\u043e \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0433\u043e\u0440\u043d\u044b\u0445 \u044d\u043a\u0441\u043a\u0443\u0440\u0441\u0438\u0439. \u041d\u0435 \u0443\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u044c\u0441\u044f \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043b\u0435\u0439, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u00ab\u0421\u0435\u0445\u0441\u0435\u043b\u043b\u0430\u0443\u0442\u0435\u043d\u00bb, \u0438 \u043e\u0449\u0443\u0442\u0438\u0442\u044c \u044f\u0440\u043a\u0438\u0439 \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442 \u043c\u0435\u0436\u0434\u0443 \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u0437\u0434\u0430\u043d\u0438\u044f\u043c\u0438 \u0441\u0442\u0430\u0440\u043e\u0433\u043e \u0433\u043e\u0440\u043e\u0434\u0430 \u0438 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u043c\u0438 \u0440\u0430\u0439\u043e\u043d\u0430\u043c\u0438.<\/p><p>\u0426\u044e\u0440\u0438\u0445 \u0433\u043e\u0440\u0434\u0438\u0442\u0441\u044f \u0441\u0432\u043e\u0438\u043c\u0438 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c\u0438 \u043c\u0443\u0437\u0435\u044f\u043c\u0438, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u043d\u0430\u043c\u0435\u043d\u0438\u0442\u044b\u0439 \u041c\u0443\u0437\u0435\u0439 \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u0430 Lindt, \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u0443\u0437\u043d\u0430\u0442\u044c \u0441\u0435\u043a\u0440\u0435\u0442\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u044d\u0442\u043e\u0433\u043e \u043b\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u0430 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u0435\u0436\u0435\u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0441\u0435\u0440\u0442\u044b. \u0421\u0435\u043c\u044c\u044f\u043c \u0442\u0430\u043a\u0436\u0435 \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u044c \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0446\u0435\u0440\u043a\u0432\u0438 \u0413\u0440\u043e\u0441\u0441\u043c\u044e\u043d\u0441\u0442\u0435\u0440 \u0438 \u0424\u0440\u0430\u043d\u0446\u043c\u044e\u043d\u0441\u0442\u0435\u0440, \u0447\u044c\u0438 \u0432\u043f\u0435\u0447\u0430\u0442\u043b\u044f\u044e\u0449\u0438\u0435 \u0432\u0438\u0442\u0440\u0430\u0436\u0438 \u043f\u043e\u0440\u0430\u0437\u044f\u0442 \u0432\u043e\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435 \u043a\u0430\u043a \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0445, \u0442\u0430\u043a \u0438 \u0434\u0435\u0442\u0435\u0439. \u042d\u0442\u043e\u0442 \u0433\u043e\u0440\u043e\u0434 \u043f\u043e\u043b\u043e\u043d \u0436\u0438\u0437\u043d\u0438, \u0430 \u0435\u0433\u043e \u0443\u044e\u0442\u043d\u044b\u0435 \u043a\u0430\u0444\u0435 \u0438 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u044b \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u044e\u0442 \u0448\u0438\u0440\u043e\u043a\u043e\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u0435 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0438\u0445 \u0434\u0435\u043b\u0438\u043a\u0430\u0442\u0435\u0441\u043e\u0432, \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u044b\u0445 \u043f\u043e\u0440\u0430\u0434\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0433\u0443\u0440\u043c\u0430\u043d\u0430.<\/p>","image":null,"text_2":"<p>\u0426\u044e\u0440\u0438\u0445 \u0441\u043b\u0430\u0432\u0438\u0442\u0441\u044f \u0441\u0432\u043e\u0435\u0439 \u043e\u0442\u043b\u0438\u0447\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0439 \u0442\u0440\u0430\u043c\u0432\u0430\u0438, \u0430\u0432\u0442\u043e\u0431\u0443\u0441\u044b \u0438 \u043f\u043e\u0435\u0437\u0434\u0430, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043b\u0435\u0433\u043a\u043e \u0434\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0434\u043e \u0432\u0441\u0435\u0445 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0442\u043e\u0447\u0435\u043a \u0433\u043e\u0440\u043e\u0434\u0430 \u0438 \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u0435\u0439. \u041f\u0440\u043e\u0433\u0443\u043b\u043a\u0430 \u043f\u043e \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0446\u0435\u043d\u0442\u0440\u0443 \u0437\u0430\u0439\u043c\u0435\u0442 \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 \u0434\u0432\u0443\u0445 \u0447\u0430\u0441\u043e\u0432, \u0430 \u0435\u0449\u0435 \u0447\u0430\u0441 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u0441\u0432\u044f\u0442\u0438\u0442\u044c \u0440\u0430\u0441\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u043e\u043c\u0443 \u043e\u0442\u0434\u044b\u0445\u0443 \u0443 \u043e\u0437\u0435\u0440\u0430. \u0421 \u0434\u0435\u0442\u044c\u043c\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0432\u0440\u0435\u043c\u044f, \u0430\u0440\u0435\u043d\u0434\u0443\u044f \u043b\u043e\u0434\u043a\u0438 \u0438\u043b\u0438 \u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0430\u043c\u044f\u0442\u043d\u0438\u043a\u0438 \u0432 \u0431\u0443\u0434\u043d\u0438\u0435 \u0434\u043d\u0438, \u043a\u043e\u0433\u0434\u0430 \u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432 \u043c\u0435\u043d\u044c\u0448\u0435. \u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043e \u0432 \u043b\u0435\u0442\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u044b \u0437\u0434\u0435\u0441\u044c \u0431\u044b\u0432\u0430\u0435\u0442 \u043c\u043d\u043e\u0433\u043e\u043b\u044e\u0434\u043d\u043e, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043b\u0435\u0439, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0438 \u0432\u0438\u0437\u0438\u0442\u044b \u0437\u0430\u0440\u0430\u043d\u0435\u0435, \u0447\u0442\u043e\u0431\u044b \u043c\u0438\u043d\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0440\u0435\u043c\u044f \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f \u0432 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0445 \u043c\u0435\u0441\u0442\u0430\u0445.<\/p><p>\u0421\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044c \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0445, \u0435\u0441\u043b\u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0435 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u044c \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0435 \u043c\u0443\u0437\u0435\u0438 \u0438\u043b\u0438 \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u044b, \u2014 \u044d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0442\u043e\u043b\u043f. \u041b\u0443\u0447\u0448\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0432\u0438\u0437\u0438\u0442\u043e\u0432 \u2014 \u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0447\u0430\u0441\u044b \u0432 \u0431\u0443\u0434\u043d\u0438\u0435 \u0434\u043d\u0438: \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435 \u0432 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e, \u0430 \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u044b\u0445 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0439.<\/p>"}}]},"ai_seasons_line":{"sections":[{"layout":"seasons_line","data":{"title":"\u041e\u0431\u0437\u043e\u0440 \u0441\u0435\u0437\u043e\u043d\u043e\u0432","jan_title":"\u042f\u043d\u0432\u0430\u0440\u044c","jan_subtitle":"\u041f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u0430\u044f \u0437\u0438\u043c\u0430","jan_text":"\u042f\u043d\u0432\u0430\u0440\u044c \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u0435\u0442 \u043e\u043a\u0443\u043d\u0443\u0442\u044c\u0441\u044f \u0432 \u043c\u0438\u0440 \u0437\u0438\u043c\u043d\u0438\u0445 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u043e\u0432. \u041d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u0435\u0441\u044c \u043c\u043e\u0440\u043e\u0437\u043d\u044b\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u043e\u043c, \u043f\u043e\u043a\u043e\u0440\u0438\u0442\u0435 \u0437\u0430\u0441\u043d\u0435\u0436\u0435\u043d\u043d\u044b\u0435 \u0441\u043a\u043b\u043e\u043d\u044b \u0438 \u0441\u043e\u0433\u0440\u0435\u0439\u0442\u0435\u0441\u044c \u0432 \u0443\u044e\u0442\u043d\u044b\u0445 \u043a\u0430\u0444\u0435, \u0433\u0434\u0435 \u0436\u0434\u0443\u0442 \u0430\u0440\u043e\u043c\u0430\u0442\u043d\u044b\u0435 \u043d\u0430\u043f\u0438\u0442\u043a\u0438.","feb_title":"\u0424\u0435\u0432\u0440\u0430\u043b\u044c","feb_subtitle":"\u0421\u043d\u0435\u0436\u043d\u044b\u0435 \u0437\u0430\u0431\u0430\u0432\u044b","feb_text":"\u0424\u0435\u0432\u0440\u0430\u043b\u044c, \u0441 \u0435\u0433\u043e \u043c\u043e\u0440\u043e\u0437\u043d\u044b\u043c\u0438 \u0434\u043d\u044f\u043c\u0438 \u0438 \u043e\u0431\u0438\u043b\u044c\u043d\u044b\u043c \u0441\u043d\u0435\u0433\u043e\u043c, \u0438\u0434\u0435\u0430\u043b\u0435\u043d \u0434\u043b\u044f \u043a\u0430\u0442\u0430\u043d\u0438\u044f \u043d\u0430 \u043a\u043e\u043d\u044c\u043a\u0430\u0445 \u0438 \u044f\u0440\u043a\u0438\u0445 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u0445 \u0440\u0430\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0439 \u043f\u043e\u0434 \u0438\u0441\u043a\u0440\u044f\u0449\u0438\u043c\u0441\u044f \u0437\u0438\u043c\u043d\u0438\u043c \u0441\u043e\u043b\u043d\u0446\u0435\u043c.","mar_title":"\u041c\u0430\u0440\u0442","mar_subtitle":"\u041d\u0430\u0447\u0430\u043b\u043e \u0432\u0435\u0441\u043d\u044b","mar_text":"\u041c\u0430\u0440\u0442 \u043f\u0440\u043e\u0431\u0443\u0436\u0434\u0430\u0435\u0442 \u043f\u0440\u0438\u0440\u043e\u0434\u0443, \u043f\u0440\u0438\u043d\u043e\u0441\u044f \u043f\u0440\u043e\u0445\u043b\u0430\u0434\u0443 \u0438 \u043f\u0440\u0435\u0434\u0432\u043a\u0443\u0448\u0435\u043d\u0438\u0435 \u0432\u0435\u0441\u0435\u043d\u043d\u0438\u0445 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u043e\u0432. \u0421 \u043a\u0430\u0436\u0434\u044b\u043c \u0434\u043d\u0451\u043c \u0432\u0441\u0451 \u0431\u043e\u043b\u044c\u0448\u0435 \u0