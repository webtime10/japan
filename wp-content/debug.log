u0433\u0438\u0435\u0439.","aug_title":"\u0410\u0432\u0433\u0443\u0441\u0442","aug_subtitle":"\u041a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u043e\u0435 \u043b\u0435\u0442\u043e","aug_text":"\u0410\u0432\u0433\u0443\u0441\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u043b\u0435\u0442\u043d\u0435\u0435 \u0442\u0435\u043f\u043b\u043e \u0438 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u0439 \u043f\u043e\u0434 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u043c \u043d\u0435\u0431\u043e\u043c. \u041e\u0442\u043b\u0438\u0447\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u044c\u0441\u044f \u043c\u0443\u0437\u044b\u043a\u043e\u0439 \u0438 \u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u043e\u043c \u043d\u0430 \u0441\u0432\u0435\u0436\u0435\u043c \u0432\u043e\u0437\u0434\u0443\u0445\u0435.","sep_title":"\u0421\u0435\u043d\u0442\u044f\u0431\u0440\u044c","sep_subtitle":"\u0411\u0430\u0440\u0445\u0430\u0442\u043d\u044b\u0439 \u0441\u0435\u0437\u043e\u043d","sep_text":"\u0421\u0435\u043d\u0442\u044f\u0431\u0440\u044c \u0440\u0430\u0434\u0443\u0435\u0442 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e\u0439 \u043f\u043e\u0433\u043e\u0434\u043e\u0439 \u0438 \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u0435\u043c \u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u0442\u043e\u043a\u0430, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u0435\u0433\u043e \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u043c\u0435\u0441\u044f\u0446\u0435\u043c \u0434\u043b\u044f \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0438 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439.","oct_title":"\u041e\u043a\u0442\u044f\u0431\u0440\u044c","oct_subtitle":"\u0417\u043e\u043b\u043e\u0442\u0430\u044f \u043e\u0441\u0435\u043d\u044c","oct_text":"\u041e\u043a\u0442\u044f\u0431\u0440\u044c \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u043e\u0441\u043e\u0431\u0443\u044e \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u0443\u044e\u0442\u0430, \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u0443\u044e \u0434\u043b\u044f \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u043c\u0443\u0437\u0435\u0435\u0432 \u0438 \u043e\u0441\u0435\u043d\u043d\u0438\u0445 \u044f\u0440\u043c\u0430\u0440\u043e\u043a. \u041d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u0435\u0441\u044c \u0442\u0432\u043e\u0440\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0438 \u0442\u0451\u043f\u043b\u044b\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c.","nov_title":"\u041d\u043e\u044f\u0431\u0440\u044c","nov_subtitle":"\u041f\u0440\u0435\u0434\u0434\u0432\u0435\u0440\u0438\u0435 \u0437\u0438\u043c\u044b","nov_text":"\u0412 \u043d\u043e\u044f\u0431\u0440\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0435 \u0437\u0438\u043c\u044b: \u043f\u0440\u043e\u0445\u043b\u0430\u0434\u043d\u0430\u044f \u043f\u043e\u0433\u043e\u0434\u0430 \u0438 \u043f\u0440\u0435\u0434\u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u0430\u044f \u0441\u0443\u0435\u0442\u0430. \u0423\u044e\u0442\u043d\u044b\u0435 \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u044b \u043f\u0440\u0438\u0433\u043b\u0430\u0448\u0430\u044e\u0442 \u043d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u044c\u0441\u044f \u0441\u0435\u0437\u043e\u043d\u043d\u044b\u043c\u0438 \u0443\u0433\u043e\u0449\u0435\u043d\u0438\u044f\u043c\u0438.","dec_title":"\u0414\u0435\u043a\u0430\u0431\u0440\u044c","dec_subtitle":"\u0417\u0438\u043c\u043d\u044f\u044f \u0441\u043a\u0430\u0437\u043a\u0430","dec_text":"\u0414\u0435\u043a\u0430\u0431\u0440\u044c \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0443\u044e \u0437\u0438\u043c\u0443, \u043d\u0430\u043f\u043e\u043b\u043d\u044f\u044f \u0432\u043e\u0437\u0434\u0443\u0445 \u043c\u043e\u0440\u043e\u0437\u043d\u043e\u0439 \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044c\u044e \u0438 \u0432\u043e\u043b\u0448\u0435\u0431\u043d\u043e\u0439 \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u0447\u043d\u043e\u0439 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043e\u0439. \u042f\u0440\u043c\u0430\u0440\u043a\u0438 \u0438 \u043a\u0430\u0442\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u043d\u0435\u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c\u044b\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u044b."}}]},"ai_faq":{"sections":[{"layout":"faq","data":{"title":"\u0426\u044e\u0440\u0438\u0445: \u043e\u0442\u0432\u0435\u0442\u044b \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0438 \u0446\u0435\u043d\u043d\u044b\u0435 \u0441\u043e\u0432\u0435\u0442\u044b","items":[{"question":"\u041a\u043e\u0433\u0434\u0430 \u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u044c \u0426\u044e\u0440\u0438\u0445?","answer":"\u0412\u0435\u0441\u043d\u0430 \u0438 \u043e\u0441\u0435\u043d\u044c \u2013 \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u0426\u044e\u0440\u0438\u0445\u0430! \u0421 \u0430\u043f\u0440\u0435\u043b\u044f \u043f\u043e \u0438\u044e\u043d\u044c \u0438 \u0441 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044f \u0434\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043a\u0442\u044f\u0431\u0440\u044f \u0437\u0434\u0435\u0441\u044c \u0446\u0430\u0440\u0438\u0442 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u0430\u044f \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430, \u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432 \u0437\u0430\u043c\u0435\u0442\u043d\u043e \u043c\u0435\u043d\u044c\u0448\u0435, \u0447\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u043f\u043e\u043b\u043d\u0430 \u043d\u0430\u0441\u043b\u0430\u0434\u0438\u0442\u044c\u0441\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u043e\u0439 \u0433\u043e\u0440\u043e\u0434\u0430."},{"question":"\u041a\u0430\u043a \u0434\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0438\u0437 \u0430\u044d\u0440\u043e\u043f\u043e\u0440\u0442\u0430 \u0432 \u0446\u0435\u043d\u0442\u0440 \u0426\u044e\u0440\u0438\u0445\u0430?","answer":"\u0414\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u043e\u0447\u0435\u043d\u044c \u043f\u0440\u043e\u0441\u0442\u043e! \u0412\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435\u0441\u044c \u043f\u043e\u0435\u0437\u0434\u043e\u043c Esbond, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u0430\u0436\u0434\u044b\u0435 10-15 \u043c\u0438\u043d\u0443\u0442. \u0412\u0441\u0435\u0433\u043e \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044c \u0447\u0430\u0441\u0430 \u0432\u044b \u043e\u043a\u0430\u0436\u0435\u0442\u0435\u0441\u044c \u043f\u0440\u044f\u043c\u043e \u0432 \u0446\u0435\u043d\u0442\u0440\u0435 \u0426\u044e\u0440\u0438\u0445\u0430 \u2013 \u044d\u0442\u043e \u0431\u044b\u0441\u0442\u0440\u043e \u0438 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u043e!"},{"question":"\u0427\u0442\u043e \u0441\u0442\u043e\u0438\u0442 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0432 \u0426\u044e\u0440\u0438\u0445\u0435?","answer":"\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0444\u043e\u043d\u0434\u044e, \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043a\u0443\u044e \u0440\u0451\u0448\u0442\u0438 \u0438, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043f\u043e\u0431\u0430\u043b\u0443\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u043d\u044b\u043c\u0438 \u0434\u0435\u0441\u0435\u0440\u0442\u0430\u043c\u0438 \u043e\u0442 \u041b\u0438\u043d\u0434\u0442 \u0438 \u0421\u043f\u0440\u044e\u043d\u0433\u043b\u0438. \u042d\u0442\u043e \u043a\u0443\u043b\u0438\u043d\u0430\u0440\u043d\u044b\u0435 \u0448\u0435\u0434\u0435\u0432\u0440\u044b, \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u0434\u0430\u043b\u0435\u043a\u043e \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u0438!"},{"question":"\u0421\u0442\u043e\u0438\u0442 \u043b\u0438 \u0430\u0440\u0435\u043d\u0434\u043e\u0432\u0430\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0432 \u0426\u044e\u0440\u0438\u0445\u0435?","answer":"\u041e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e \u0441\u0442\u043e\u0438\u0442! \u0410\u0440\u0435\u043d\u0434\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043f\u0440\u043e\u0441\u0442\u0438\u0442 \u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u044f \u043f\u043e \u0436\u0438\u0432\u043e\u043f\u0438\u0441\u043d\u044b\u043c \u043e\u043a\u0440\u0435\u0441\u0442\u043d\u043e\u0441\u0442\u044f\u043c \u0438 \u0433\u043e\u0440\u043d\u044b\u043c \u0440\u0430\u0439\u043e\u043d\u0430\u043c. \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u0428\u0432\u0435\u0439\u0446\u0430\u0440\u0438\u044e \u0441 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043e\u043c!"},{"question":"\u041a\u0430\u043a\u0438\u0435 \u043b\u0435\u0442\u043d\u0438\u0435 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f \u043f\u0440\u043e\u0445\u043e\u0434\u044f\u0442 \u0432 \u0426\u044e\u0440\u0438\u0445\u0435?","answer":"\u0412 \u043b\u0435\u0442\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u044b \u0433\u043e\u0440\u043e\u0434 \u043e\u0436\u0438\u0432\u0430\u0435\u0442 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u043e\u0431\u0438\u043b\u0438\u044e \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043b\u0435\u0439, \u0441\u0440\u0435\u0434\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 Zurcher Theater Spectacle \u0438 Street Parade \u2013 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u043d\u044b\u0435 \u043e\u0434\u043d\u0438\u043c\u0438 \u0438\u0437 \u0441\u0430\u043c\u044b\u0445 \u0433\u0440\u0430\u043d\u0434\u0438\u043e\u0437\u043d\u044b\u0445 \u0432 \u0415\u0432\u0440\u043e\u043f\u0435!"}]}}]}},"en":{"ai_text_about_the_country":{"sections":[{"layout":"text_country","data":{"title":"Zurich: Your Family\u2019s Gateway to Excitement and Relaxation","text":"<p>Welcome to Zurich, Switzerland's largest city and vibrant heart, where urban energy meets natural serenity. This enchanting destination offers families the perfect blend of exciting adventures and relaxing getaways. Nestled by the crystal-clear waters of Lake Zurich and embraced by the majestic Swiss Alps, the city captivates with its stunning scenery and countless opportunities for discovery. Stroll through the charming lanes of the Old Town, and you'll discover a delightful mix of historic architecture, bustling boutiques, and inviting restaurants, creating an atmosphere that delights visitors of all ages.<\/p><p>Beyond its urban beauty, Zurich is a true playground for adventure! Enjoy captivating outdoor activities, from serene boat rides on the shimmering lake to invigorating excursions into the majestic mountains. A must-visit is the famous Lindt Home of Chocolate museum: a treat for all ages, featuring engaging exhibits and, of course, delicious chocolate tastings. With lush parks like the Zurich Botanical Garden and scenic hiking trails, children will find abundant opportunities to explore and create lasting family memories.<\/p>","image":null,"text_2":"<p>Getting to Zurich is straightforward, thanks to its efficient public transport system, which includes trams, buses, and trains connecting you effortlessly to every corner of the city and beyond. The Zurich Card offers unlimited travel and complimentary entry to various museums, making it an excellent value for families looking to maximize their exploration without overspending. To fully experience all this captivating city has to offer, we recommend allocating at least two to three days for your visit, including excursions to nearby attractions.<\/p><p>Families with children will find Zurich exceptionally welcoming, with an abundance of child-friendly eateries and attractions. However, be aware that peak tourist season, especially in summer, can lead to larger crowds at popular spots. For a more relaxed experience at landmarks like the Grossm\u00fcnster and the Swiss National Museum, plan your visits for earlier in the day.<\/p>"}}]},"ai_seasons_line":{"sections":[{"layout":"seasons_line","data":{"title":"Zurich's Seasonal Delights","jan_title":"January","jan_subtitle":"Winter Wonderland","jan_text":"As the new year begins, January wraps Zurich in a magical winter embrace, with snowflakes gently falling. It's a perfect time for exhilarating winter sports or cozying up in charming caf\u00e9s, sipping hot chocolate before exploring the lively festive markets.","feb_title":"February","feb_subtitle":"Winter Festivities","feb_text":"February retains its enchanting winter allure, offering a wealth of joyful activities for families. From graceful ice skating to thrilling winter sports, the city comes alive with events that celebrate the season and highlight rich local traditions.","mar_title":"March","mar_subtitle":"Spring Awakening","mar_text":"With March's arrival, Zurich sheds winter's embrace and welcomes the vibrant first signs of spring. As temperatures rise, the city awakens with blooming flowers and lively outdoor events, creating an ideal setting for sightseeing amidst its newfound botanical splendor.","apr_title":"April","apr_subtitle":"Blooming Beauty","apr_text":"April adorns Zurich with vibrant blossoms and inviting warmth, drawing visitors outside. As spring truly takes hold, pack a picnic and head to the lake, immersing yourself in nature's reinvigorated beauty and the cheerful ambiance it inspires.","may_title":"May","may_subtitle":"Sunny Days","may_text":"With May's arrival, warmer days bathe the landscape in brilliant blooms, signaling endless outdoor adventures. Discover the lively start of festival season, whether you're exploring lush hiking trails or relaxing in sun-kissed parks vibrant with activity.","jun_title":"June","jun_subtitle":"Summer Fun","jun_text":"June ushers in summer to Zurich, with the air buzzing with lively festivals and outdoor gatherings. Savor the warm temperatures and vibrant lakeside activities, where joy and laughter become an integral part of the unforgettable summer season.","jul_title":"July","jul_subtitle":"Peak Summer","jul_text":"July truly embodies summer, radiating warmth and energy, making it a superb month for family fun by the lake. Whether enjoying a leisurely cruise or immersing yourself in local festivals, the city thrives with endless summer adventures.","aug_title":"August","aug_subtitle":"Festive Vibes","aug_text":"August prolongs summer's warmth, presenting a rich array of outdoor events and exhilarating water sports. The atmosphere vibrates with energy as both locals and visitors delight in cheerful lakeside festivities, crafting lasting memories.","sep_title":"September","sep_subtitle":"Autumn Colors","sep_text":"September ushers in a crisp, gentle breeze, revealing stunning autumn foliage. It\u2019s an ideal time for scenic hikes and apple picking across the surrounding countryside, inviting you to reconnect with nature and immerse yourself in the season's transformative beauty.","oct_title":"October","oct_subtitle":"Crisp Air","oct_text":"October welcomes you with refreshingly cool air, creating a perfect backdrop for family outings amid a landscape ablaze with spectacular autumn colors. Immerse yourself in the joyful atmosphere of harvest festivals and engage in diverse outdoor activities celebrating this vibrant season.","nov_title":"November","nov_subtitle":"First Snow","nov_text":"As November progresses towards winter, a distinct chill arrives, often bringing the first magical snowfall. Embrace the cozy ambiance of indoor attractions while discovering the enchanting festive markets that emerge, beckoning everyone to celebrate the season.","dec_title":"December","dec_subtitle":"Holiday Cheer","dec_text":"December envelops Zurich in a magical glow, with twinkling lights adorning the streets and vibrant Christmas markets brimming with festive cheer. It's an ideal month for families to fully embrace the holiday spirit and forge cherished memories."}}]},"ai_faq":{"sections":[{"layout":"faq","data":{"title":"Your Zurich Journey: Frequently Asked Questions","items":[{"question":"When is the best time to visit Zurich?","answer":"The ideal times to visit Zurich are during spring (April\u2013June) and early autumn (September\u2013October). These months offer pleasantly mild weather and fewer crowds, perfect for exploring the city."},{"question":"How efficient is public transport in Zurich?","answer":"Zurich boasts a highly efficient public transport network. With extensive tram, train, and bus services, navigating the city is both easy and comfortable."},{"question":"What family-friendly activities are available in Zurich?","answer":"Families will love the interactive exhibits at the Lindt Home of Chocolate, appealing to all ages. Another excellent option is a scenic boat cruise on Lake Zurich, offering stunning views of the city and surroundings."},{"question":"Is it easy to rent a car in Zurich?","answer":"Renting a car in Zurich is straightforward if you plan to explore the picturesque Swiss countryside at your own pace. Several rental agencies are available throughout the city."},{"question":"Are there good dining options that cater to families?","answer":"Yes, Zurich offers a diverse culinary scene with many family-friendly dining options. You\u2019ll find everything from traditional Swiss cuisine to modern eateries, ensuring there\u2019s something to please every palate."},{"question":"What outdoor adventures can we enjoy with kids?","answer":"Take your family on a rewarding hike up Uetliberg Mountain for breathtaking panoramic views of Zurich. Alternatively, pack a picnic and relax by the beautiful shores of Lake Zurich."},{"question":"Is Zurich a convenient base for exploring the Swiss Alps?","answer":"Absolutely. Zurich's central location makes it an ideal starting point for day trips to many stunning Swiss Alps destinations, including the charming towns of Lucerne and Interlaken."},{"question":"How far are the Rhine Falls from Zurich?","answer":"The Rhine Falls are approximately a 50-minute train ride from Zurich, making them a perfect destination for a day trip to experience Europe's largest waterfall."},{"question":"What iconic landmarks should visitors see in Zurich?","answer":"The Grossm\u00fcnster church, with its distinctive twin towers, is a must-visit landmark. It offers insight into Zurich's rich history and provides visitors with impressive views from its towers."}]}}]}},"he":{"ai_text_about_the_country":{"sections":[{"layout":"text_country","data":{"title":"\u05e6\u05d9\u05e8\u05d9\u05da: \u05e4\u05e0\u05d9\u05e0\u05d4 \u05e9\u05d5\u05d5\u05d9\u05e6\u05e8\u05d9\u05ea \u05e9\u05dc \u05d9\u05d5\u05e4\u05d9 \u05d5\u05e4\u05d0\u05e8","text":"<p>\u05e6\u05d9\u05e8\u05d9\u05da, \u05d4\u05e2\u05d9\u05e8 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4 \u05d5\u05d4\u05d0\u05dc\u05d2\u05e0\u05d8\u05d9\u05ea \u05d1\u05e9\u05d5\u05d5\u05d9\u05d9\u05e5, \u05de\u05e6\u05d9\u05e2\u05d4 \u05d7\u05d5\u05d5\u05d9\u05d4 \u05e2\u05e9\u05d9\u05e8\u05d4 \u05d5\u05de\u05d2\u05d5\u05d5\u05e0\u05ea, \u05e9\u05d1\u05d4 \u05e0\u05d5\u05e4\u05d9\u05dd \u05e2\u05d5\u05e6\u05e8\u05d9 \u05e0\u05e9\u05d9\u05de\u05d4 \u05de\u05e9\u05ea\u05dc\u05d1\u05d9\u05dd \u05d1\u05d4\u05e8\u05de\u05d5\u05e0\u05d9\u05d4 \u05de\u05d5\u05e9\u05dc\u05de\u05ea \u05e2\u05dd \u05d7\u05d9\u05d9 \u05e2\u05d9\u05e8 \u05ea\u05d5\u05e1\u05e1\u05d9\u05dd. \u05d4\u05e2\u05d9\u05e8 \u05e9\u05d5\u05db\u05e0\u05ea \u05dc\u05d2\u05d3\u05d5\u05ea \u05d0\u05d2\u05dd \u05e6\u05d9\u05e8\u05d9\u05da (Lake Zurich), \u05de\u05d5\u05e7\u05e4\u05ea \u05d1\u05d4\u05e8\u05d9 \u05d4\u05d0\u05dc\u05e4\u05d9\u05dd \u05d4\u05de\u05d5\u05e9\u05dc\u05d2\u05d9\u05dd, \u05d5\u05d9\u05d5\u05e6\u05e8\u05ea \u05e9\u05d9\u05dc\u05d5\u05d1 \u05de\u05e8\u05d4\u05d9\u05d1 \u05d4\u05e2\u05d5\u05e6\u05e8 \u05d0\u05ea \u05d4\u05e0\u05e9\u05d9\u05de\u05d4. \u05db\u05d0\u05df \u05ea\u05d2\u05dc\u05d5 \u05d0\u05ea \u05de\u05d9\u05d8\u05d1 \u05e7\u05e1\u05de\u05d9\u05d4 \u05e9\u05dc \u05e9\u05d5\u05d5\u05d9\u05d9\u05e5 \u2013 \u05de\u05db\u05e0\u05e1\u05d9\u05d5\u05ea \u05e2\u05ea\u05d9\u05e7\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e4\u05d5\u05d0\u05e8\u05ea \u05d5\u05e2\u05d3 \u05d7\u05e0\u05d5\u05d9\u05d5\u05ea \u05d9\u05d5\u05e7\u05e8\u05d4 \u05e0\u05d5\u05e6\u05e6\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05e8\u05d7\u05d5\u05d1 \u05d1\u05d4\u05e0\u05d5\u05e4\u05e9\u05d8\u05e8\u05d0\u05e1\u05d4 (Bahnhofstrasse). \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05d1\u05e2\u05d9\u05e8 \u05ea\u05d5\u05e1\u05e1\u05ea \u05d5\u05de\u05dc\u05d0\u05ea \u05d7\u05d9\u05d9\u05dd, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e2\u05d5\u05e0\u05ea \u05e4\u05e1\u05d8\u05d9\u05d1\u05dc\u05d9 \u05d4\u05e7\u05d9\u05e5, \u05d4\u05de\u05d1\u05d9\u05d0\u05d9\u05dd \u05e2\u05de\u05dd \u05e9\u05de\u05d7\u05d4 \u05d5\u05e8\u05d9\u05d2\u05d5\u05e9 \u05dc\u05db\u05dc \u05e4\u05d9\u05e0\u05d4. \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d9\u05d9\u05d4\u05e0\u05d5 \u05de\u05e9\u05e4\u05e2 \u05e9\u05dc \u05ea\u05e8\u05d1\u05d5\u05ea \u05d5\u05e4\u05e0\u05d0\u05d9, \u05e2\u05dd \u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05e0\u05d9\u05dd \u05d5\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc\u05db\u05dc \u05d2\u05d9\u05dc, \u05db\u05d5\u05dc\u05dd \u05e0\u05d2\u05d9\u05e9\u05d9\u05dd \u05d5\u05e7\u05e8\u05d5\u05d1\u05d9\u05dd \u05dc\u05de\u05e8\u05db\u05d6 \u05d4\u05e2\u05d9\u05e8.<\/p><p>\u05d0\u05d7\u05ea \u05de\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05d7\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05d9\u05e7\u05d5\u05e8 \u05d1\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d4\u05e9\u05d5\u05e7\u05d5\u05dc\u05d3 \u05dc\u05d9\u05e0\u05d3\u05d8 (Lindt Home of Chocolate), \u05d4\u05de\u05e6\u05d9\u05e2 \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d8\u05e2\u05d9\u05de\u05d5\u05ea \u05e9\u05d5\u05e7\u05d5\u05dc\u05d3 \u05de\u05e9\u05d5\u05d1\u05d7\u05d5\u05ea \u05d4\u05de\u05d2\u05e8\u05d5\u05ea \u05d0\u05ea \u05db\u05dc \u05d4\u05d7\u05d5\u05e9\u05d9\u05dd. \u05dc\u05e8\u05d2\u05e2\u05d9\u05dd \u05e9\u05dc \u05e9\u05dc\u05d5\u05d5\u05d4 \u05d5\u05e0\u05d5\u05e3 \u05e2\u05d5\u05e6\u05e8 \u05e0\u05e9\u05d9\u05de\u05d4, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e6\u05d0\u05ea \u05dc\u05e1\u05d9\u05d5\u05e8 \u05e9\u05d9\u05d9\u05d8 \u05de\u05e8\u05d2\u05d9\u05e2 \u05d1\u05d0\u05d2\u05dd \u05e6\u05d9\u05e8\u05d9\u05da. \u05db\u05e0\u05e1\u05d9\u05d5\u05ea \u05de\u05e8\u05e9\u05d9\u05de\u05d5\u05ea, \u05db\u05de\u05d5 \u05d2\u05e8\u05d5\u05e1\u05de\u05d5\u05e0\u05e1\u05d8\u05e8 (Grossm\u00fcnster) \u05d4\u05d9\u05d3\u05d5\u05e2\u05d4, \u05de\u05e9\u05e7\u05e4\u05d5\u05ea \u05d0\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05e2\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d6\u05d5\u05e8 \u05d3\u05e8\u05da \u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05d4 \u05de\u05e8\u05d4\u05d9\u05d1\u05d4. \u05d4\u05df \u05de\u05d6\u05de\u05e0\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05dc\u05d4\u05e2\u05de\u05d9\u05e7 \u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05e9\u05d5\u05d5\u05d9\u05e6\u05e8\u05d9\u05ea \u05ea\u05d5\u05da \u05db\u05d3\u05d9 \u05d2\u05d9\u05dc\u05d5\u05d9 \u05e4\u05d9\u05e0\u05d5\u05ea \u05d7\u05de\u05d3 \u05d9\u05e8\u05d5\u05e7\u05d5\u05ea \u05d5\u05e4\u05d0\u05e8\u05e7\u05d9\u05dd \u05e4\u05e1\u05d8\u05d5\u05e8\u05dc\u05d9\u05d9\u05dd.<\/p>","image":null,"text_2":"<p>\u05d4\u05d4\u05d2\u05e2\u05d4 \u05dc\u05e6\u05d9\u05e8\u05d9\u05da \u05e7\u05dc\u05d4 \u05d5\u05e0\u05d5\u05d7\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3, \u05d1\u05d6\u05db\u05d5\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05d4\u05de\u05e6\u05d5\u05d9\u05e0\u05ea \u05e9\u05dc\u05d4. \u05e0\u05de\u05dc \u05d4\u05ea\u05e2\u05d5\u05e4\u05d4 \u05d4\u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9 \u05e9\u05dc \u05e6\u05d9\u05e8\u05d9\u05da (Zurich Airport) \u05de\u05de\u05d5\u05e7\u05dd \u05db-10 \u05e7\"\u05de \u05de\u05de\u05e8\u05db\u05d6 \u05d4\u05e2\u05d9\u05e8, \u05d5\u05e0\u05e1\u05d9\u05e2\u05d4 \u05d1\u05e8\u05db\u05d1\u05ea \u05d0\u05d5\u05e8\u05db\u05ea \u05db-15 \u05d3\u05e7\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3. \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d4\u05e2\u05d9\u05e8, \u05d4\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05d9\u05e2\u05d9\u05dc\u05d4 \u05d5\u05e0\u05d2\u05d9\u05e9\u05d4, \u05e2\u05dd \u05e8\u05db\u05d1\u05d5\u05ea \u05e7\u05dc\u05d5\u05ea (\u05d8\u05e8\u05de\u05d9\u05dd) \u05d5\u05d0\u05d5\u05d8\u05d5\u05d1\u05d5\u05e1\u05d9\u05dd \u05d4\u05de\u05db\u05e1\u05d9\u05dd \u05d0\u05ea \u05db\u05dc \u05d4\u05d0\u05d6\u05d5\u05e8. \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e8\u05db\u05d5\u05e9 \u05d0\u05ea \u05db\u05e8\u05d8\u05d9\u05e1 \u05e6\u05d9\u05e8\u05d9\u05da (Zurich Card), \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05e0\u05e1\u05d9\u05e2\u05d5\u05ea \u05d1\u05dc\u05ea\u05d9 \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d1\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05d5\u05de\u05e2\u05e0\u05d9\u05e7 \u05d4\u05e0\u05d7\u05d5\u05ea \u05dc\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05e0\u05d9\u05dd \u05d5\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea.<\/p><p>\u05ea\u05db\u05e0\u05d5\u05df \u05de\u05d5\u05e7\u05e4\u05d3 \u05e9\u05dc \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d4\u05d5\u05d0 \u05e6\u05e2\u05d3 \u05d7\u05d9\u05d5\u05e0\u05d9, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e2\u05d5\u05e0\u05d5\u05ea \u05d4\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea \u05d4\u05e2\u05de\u05d5\u05e1\u05d5\u05ea, \u05d0\u05d6 \u05d4\u05d0\u05ea\u05e8\u05d9\u05dd \u05d4\u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05dc\u05d0\u05d9\u05dd. \u05d0\u05dd \u05d1\u05db\u05d5\u05d5\u05e0\u05ea\u05db\u05dd \u05dc\u05d1\u05e7\u05e8 \u05d1\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d4\u05e9\u05d5\u05e7\u05d5\u05dc\u05d3 \u05d0\u05d5 \u05d4\u05db\u05e0\u05e1\u05d9\u05d5\u05ea, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d6\u05de\u05d9\u05df \u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05dd \u05de\u05e8\u05d0\u05e9 \u05d0\u05d5 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05d1\u05e9\u05e2\u05d5\u05ea \u05e4\u05d7\u05d5\u05ea \u05e2\u05de\u05d5\u05e1\u05d5\u05ea. \u05e6\u05d9\u05e8\u05d9\u05da \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d9\u05e2\u05d3 \u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9 \u05dc\u05de\u05e9\u05e4\u05d7\u05d5\u05ea, \u05e2\u05dd \u05de\u05d2\u05d5\u05d5\u05df \u05e8\u05d7\u05d1 \u05e9\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e9\u05d9\u05e9\u05de\u05d7\u05d5 \u05db\u05dc \u05d9\u05dc\u05d3.<\/p>"}}]},"ai_seasons_line":{"sections":[{"layout":"seasons_line","data":{"title":"\u05dc\u05d5\u05d7 \u05e2\u05d5\u05e0\u05d5\u05ea","jan_title":"\u05d9\u05e0\u05d5\u05d0\u05e8","jan_subtitle":"\u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d7\u05d5\u05e8\u05e4\u05d9\u05d5\u05ea","jan_text":"\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05d4\u05e7\u05e8\u05d9\u05e8\u05d5\u05ea, \u05d9\u05e0\u05d5\u05d0\u05e8 \u05e8\u05d5\u05d7\u05e9 \u05d1\u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d4\u05d7\u05d5\u05e8\u05e3 \u05d4\u05de\u05de\u05dc\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05d1\u05d7\u05de\u05d9\u05de\u05d5\u05ea \u05d5\u05d1\u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05e7\u05e1\u05d5\u05de\u05d4.","feb_title":"\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8","feb_subtitle":"\u05e2\u05d5\u05e0\u05d4 \u05e9\u05dc \u05e1\u05e4\u05d5\u05e8\u05d8 \u05d7\u05d5\u05e8\u05e4\u05d9","feb_text":"\u05d4\u05d7\u05d5\u05e8\u05e3 \u05de\u05de\u05e9\u05d9\u05da \u05d1\u05de\u05dc\u05d5\u05d0 \u05e2\u05d5\u05d6\u05d5, \u05d5\u05d0\u05d5\u05d4\u05d1\u05d9 \u05e1\u05e4\u05d5\u05e8\u05d8 \u05d4\u05d7\u05d5\u05e8\u05e3 \u05d9\u05de\u05e6\u05d0\u05d5 \u05db\u05d0\u05df \u05d0\u05ea \u05de\u05d1\u05d5\u05e7\u05e9\u05dd. \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05e8\u05d1\u05d5\u05ea \u05e0\u05d5\u05d4\u05e8\u05d5\u05ea \u05dc\u05d4\u05e8\u05d9\u05dd \u05d4\u05de\u05d5\u05e9\u05dc\u05d2\u05d9\u05dd \u05dc\u05d7\u05d5\u05e4\u05e9\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05db\u05d7\u05ea.","mar_title":"\u05de\u05e8\u05e5","mar_subtitle":"\u05d0\u05d1\u05d9\u05d1 \u05de\u05ea\u05d2\u05dc\u05d4","mar_text":"\u05de\u05e8\u05e5 \u05de\u05e1\u05de\u05df \u05d0\u05ea \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d0\u05d1\u05d9\u05d1, \u05db\u05e9\u05d4\u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05e2\u05d5\u05dc\u05d5\u05ea \u05d5\u05d4\u05e2\u05d9\u05e8 \u05de\u05ea\u05e2\u05d5\u05e8\u05e8\u05ea \u05dc\u05d7\u05d9\u05d9\u05dd \u05e2\u05dd \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05de\u05e8\u05ea\u05e7\u05d9\u05dd \u05d5\u05de\u05dc\u05d0\u05d9 \u05e9\u05de\u05d7\u05d4.","apr_title":"\u05d0\u05e4\u05e8\u05d9\u05dc","apr_subtitle":"\u05e4\u05e8\u05d9\u05d7\u05d4 \u05d5\u05de\u05e1\u05d9\u05d1\u05d5\u05ea \u05d0\u05d1\u05d9\u05d1","apr_text":"\u05d0\u05e4\u05e8\u05d9\u05dc \u05de\u05d1\u05d9\u05d0 \u05e2\u05de\u05d5 \u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05e0\u05e2\u05d9\u05de\u05d5\u05ea, \u05e9\u05e4\u05e2 \u05e9\u05dc \u05e4\u05e8\u05d9\u05d7\u05d5\u05ea \u05e6\u05d1\u05e2\u05d5\u05e0\u05d9\u05d5\u05ea, \u05d5\u05d1\u05e2\u05d9\u05e7\u05e8 \u2013 \u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d0\u05d1\u05d9\u05d1 \u05de\u05dc\u05d0\u05d9 \u05d7\u05d9\u05d9\u05dd.","may_title":"\u05de\u05d0\u05d9","may_subtitle":"\u05d7\u05d5\u05e4\u05e9\u05d5\u05ea \u05d0\u05d1\u05d9\u05d1","may_text":"\u05d0\u05d5\u05d5\u05d9\u05e8 \u05e6\u05dc\u05d5\u05dc \u05d5\u05e0\u05e2\u05d9\u05dd \u05dc\u05e6\u05d3 \u05e9\u05dc\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d5\u05ea \u05d9\u05d5\u05e6\u05e8\u05d9\u05dd \u05d7\u05d5\u05e4\u05e9\u05ea \u05d0\u05d1\u05d9\u05d1 \u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05ea \u05de\u05dc\u05d0\u05d4 \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea \u05d7\u05d5\u05e4\u05e9 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea.","jun_title":"\u05d9\u05d5\u05e0\u05d9","jun_subtitle":"\u05d7\u05d5\u05dd \u05e7\u05d9\u05e5","jun_text":"\u05e2\u05dd \u05d1\u05d5\u05d0 \u05d4\u05e7\u05d9\u05e5 \u05d5\u05d4\u05ea\u05d7\u05de\u05de\u05d5\u05ea \u05de\u05d6\u05d2 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8, \u05d9\u05d5\u05e0\u05d9 \u05de\u05d1\u05d9\u05d0 \u05e2\u05de\u05d5 \u05e9\u05e4\u05e2 \u05e9\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d5\u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d4\u05de\u05d7\u05d9\u05d5\u05ea \u05d0\u05ea \u05de\u05e8\u05db\u05d6 \u05d4\u05e2\u05d9\u05e8.","jul_title":"\u05d9\u05d5\u05dc\u05d9","jul_subtitle":"\u05e7\u05d9\u05e5 \u05ea\u05d5\u05e1\u05e1 \u05d5\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d2\u05d9\u05d2\u05d9\u05d9\u05dd","jul_text":"\u05d9\u05d5\u05dc\u05d9 \u05de\u05d1\u05d9\u05d0 \u05e2\u05de\u05d5 \u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05e2\u05dc\u05d9\u05d6\u05d4, \u05d7\u05d5\u05e4\u05d9\u05dd \u05e9\u05d5\u05e7\u05e7\u05d9\u05dd \u05d5\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc\u05d9\u05dd \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d4\u05de\u05e6\u05d9\u05e2\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05df \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05dc\u05db\u05dc \u05d4\u05de\u05e9\u05e4\u05d7\u05d4.","aug_title":"\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8","aug_subtitle":"\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05e7\u05d9\u05e5 \u05d1\u05e9\u05d9\u05d0\u05dd","aug_text":"\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8, \u05e9\u05d9\u05d0\u05d5 \u05e9\u05dc \u05d4\u05e7\u05d9\u05e5, \u05de\u05e6\u05d9\u05e2 \u05dc\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05dc\u05d9\u05d4\u05e0\u05d5\u05ea \u05de\u05de\u05d2\u05d5\u05d5\u05df \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05e6\u05d3 \u05d4\u05d0\u05d2\u05dd \u05d4\u05d9\u05e4\u05d4.","sep_title":"\u05e1\u05e4\u05d8\u05de\u05d1\u05e8","sep_subtitle":"\u05ea\u05e9\u05e2\u05ea \u05d4\u05ea\u05e4\u05d5\u05d7\u05d9\u05dd","sep_text":"\u05e2\u05dd \u05db\u05e0\u05d9\u05e1\u05ea \u05d4\u05e1\u05ea\u05d9\u05d5, \u05e1\u05d5\u05e4\u05d9 \u05d4\u05e9\u05d1\u05d5\u05e2 \u05de\u05ea\u05de\u05dc\u05d0\u05d9\u05dd \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d5\u05d1\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc\u05d9\u05dd \u05d7\u05e7\u05dc\u05d0\u05d9\u05d9\u05dd \u05d4\u05d7\u05d5\u05d2\u05d2\u05d9\u05dd \u05d0\u05ea \u05d4\u05e2\u05d5\u05e0\u05d4 \u05d1\u05e8\u05d5\u05d1 \u05e2\u05dd.","oct_title":"\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8","oct_subtitle":"\u05e6\u05d1\u05e2\u05d9 \u05e9\u05dc\u05db\u05ea \u05d5\u05e8\u05e2\u05e0\u05e0\u05d5\u05ea \u05e1\u05ea\u05d5\u05d5\u05d9\u05ea","oct_text":"\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 \u05de\u05d1\u05d9\u05d0 \u05e2\u05de\u05d5 \u05e8\u05e2\u05e0\u05e0\u05d5\u05ea \u05e1\u05ea\u05d5\u05d5\u05d9\u05ea \u05d5\u05d0\u05d5\u05d5\u05d9\u05e8\u05d4 \u05de\u05ea\u05d7\u05d3\u05e9\u05ea, \u05db\u05e9\u05d4\u05e0\u05d5\u05e4\u05d9\u05dd \u05d4\u05de\u05e8\u05d4\u05d9\u05d1\u05d9\u05dd \u05de\u05d5\u05e9\u05db\u05d9\u05dd \u05d0\u05dc\u05d9\u05d4\u05dd \u05de\u05d8\u05d9\u05d9\u05dc\u05d9\u05dd \u05de\u05db\u05dc \u05e7\u05e6\u05d5\u05d5\u05ea \u05ea\u05d1\u05dc.","nov_title":"\u05e0\u05d5\u05d1\u05de\u05d1\u05e8","nov_subtitle":"\u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d7\u05d5\u05e8\u05e3","nov_text":"\u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05d4\u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d4\u05d7\u05d5\u05e8\u05e4\u05d9\u05d5\u05ea, \u05db\u05e9\u05d4\u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05d9\u05d5\u05e8\u05d3\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd \u05d7\u05de\u05d9\u05dd \u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05d0\u05ea \u05e4\u05e0\u05d9 \u05d4\u05de\u05d1\u05e7\u05e8\u05d9\u05dd.","dec_title":"\u05d3\u05e6\u05de\u05d1\u05e8","dec_subtitle":"\u05e7\u05e1\u05dd \u05d7\u05d2\u05d9 \u05d4\u05d7\u05d5\u05e8\u05e3","dec_text":"\u05d3\u05e6\u05de\u05d1\u05e8 \u05de\u05d1\u05d9\u05d0 \u05e2\u05de\u05d5 \u05d0\u05ea \u05e7\u05e1\u05de\u05dd \u05e9\u05dc \u05d7\u05d2\u05d9 \u05d4\u05d7\u05d5\u05e8\u05e3, \u05d8\u05de\u05e4\u05e8\u05d8\u05d5\u05e8\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d9\u05dd \u05d4\u05de\u05d0\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05e2\u05d9\u05e8 \u05d1\u05d0\u05d5\u05e8 \u05de\u05d9\u05d5\u05d7\u05d3."}}]},"ai_faq":{"sections":[{"layout":"faq","data":{"title":"\u05d8\u05d9\u05e4\u05d9\u05dd \u05dc\u05de\u05d8\u05d9\u05d9\u05dc \u05d1\u05e6\u05d9\u05e8\u05d9\u05da","items":[{"question":"\u05de\u05d4\u05d9 \u05d4\u05e2\u05d5\u05e0\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d1\u05e6\u05d9\u05e8\u05d9\u05da?","answer":"\u05d4\u05e2\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05d5\u05ea \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d1\u05e6\u05d9\u05e8\u05d9\u05da \u05d4\u05df \u05d4\u05d0\u05d1\u05d9\u05d1 (\u05de\u05e8\u05e5\u2013\u05de\u05d0\u05d9) \u05d5\u05d4\u05e1\u05ea\u05d9\u05d5 (\u05e1\u05e4\u05d8\u05de\u05d1\u05e8\u2013\u05e0\u05d5\u05d1\u05de\u05d1\u05e8). \u05d1\u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5, \u05de\u05d6\u05d2 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05e0\u05e2\u05d9\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d5\u05d4\u05e2\u05d9\u05e8 \u05e4\u05d7\u05d5\u05ea \u05e2\u05de\u05d5\u05e1\u05d4 \u05d1\u05ea\u05d9\u05d9\u05e8\u05d9\u05dd."},{"question":"\u05d4\u05d0\u05dd \u05db\u05d3\u05d0\u05d9 \u05dc\u05e9\u05db\u05d5\u05e8 \u05e8\u05db\u05d1 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8?","answer":"\u05d1\u05d4\u05d7\u05dc\u05d8. \u05d4\u05e9\u05db\u05e8\u05ea \u05e8\u05db\u05d1 \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05de\u05d0\u05d5\u05d3, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05dd \u05d1\u05db\u05d5\u05d5\u05e0\u05ea\u05db\u05dd \u05dc\u05e6\u05d0\u05ea \u05dc\u05d8\u05d9\u05d5\u05dc\u05d9\u05dd \u05d1\u05d0\u05dc\u05e4\u05d9\u05dd \u05d4\u05e1\u05de\u05d5\u05db\u05d9\u05dd \u05d0\u05d5 \u05dc\u05d7\u05e7\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d4\u05db\u05e4\u05e8\u05d9\u05d9\u05dd \u05e9\u05de\u05e1\u05d1\u05d9\u05d1 \u05dc\u05e6\u05d9\u05e8\u05d9\u05da."},{"question":"\u05d0\u05d9\u05dc\u05d5 \u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d5\u05ea \u05d9\u05e9 \u05d1\u05e2\u05d9\u05e8?","answer":"\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d4\u05e9\u05d5\u05e7\u05d5\u05dc\u05d3 \u05e9\u05dc \u05dc\u05d9\u05e0\u05d3\u05d8 (Lindt Home of Chocolate) \u05d5\u05de\u05e4\u05dc\u05d9 \u05d4\u05e8\u05d9\u05d9\u05df (Rhine Falls) \u05d4\u05dd \u05d9\u05e2\u05d3\u05d9\u05dd \u05e0\u05d4\u05d3\u05e8\u05d9\u05dd \u05dc\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d5\u05de\u05d1\u05d8\u05d9\u05d7\u05d9\u05dd \u05d7\u05d5\u05d5\u05d9\u05d4 \u05de\u05d4\u05e0\u05d4 \u05dc\u05db\u05d5\u05dc\u05dd."},{"question":"\u05d0\u05d9\u05da \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d2\u05d9\u05e2 \u05de\u05d4\u05e9\u05d3\u05d4 \u05d4\u05ea\u05e2\u05d5\u05e4\u05d4 \u05dc\u05e6\u05d9\u05e8\u05d9\u05da?","answer":"\u05d4\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05de\u05e6\u05d9\u05e2\u05d4 \u05d3\u05e8\u05da \u05d9\u05e2\u05d9\u05dc\u05d4 \u05d5\u05e0\u05d5\u05d7\u05d4 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05de\u05e9\u05d3\u05d4 \u05d4\u05ea\u05e2\u05d5\u05e4\u05d4 \u05dc\u05dc\u05d1 \u05e6\u05d9\u05e8\u05d9\u05da. \u05e8\u05db\u05d1\u05d5\u05ea \u05d9\u05d5\u05e6\u05d0\u05d5\u05ea \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4, \u05db\u05dc 10-15 \u05d3\u05e7\u05d5\u05ea, \u05d5\u05d4\u05e0\u05e1\u05d9\u05e2\u05d4 \u05d0\u05d5\u05e8\u05db\u05ea \u05db-15 \u05d3\u05e7\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3."},{"question":"\u05d0\u05d9\u05dc\u05d5 \u05de\u05e1\u05e2\u05d3\u05d5\u05ea \u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05de\u05d5\u05de\u05dc\u05e6\u05d5\u05ea \u05d9\u05e9 \u05d1\u05e6\u05d9\u05e8\u05d9\u05da?","answer":"\u05db\u05d3\u05d0\u05d9 \u05dc\u05db\u05dd \u05dc\u05d1\u05e7\u05e8 \u05d1\u05d0\u05d7\u05ea \u05de\u05de\u05e1\u05e2\u05d3\u05d5\u05ea \u05d4\u05d2\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05e1\u05d5\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d3\u05d5\u05d2\u05de\u05ea Zunfthaus zur Waag, \u05db\u05d3\u05d9 \u05dc\u05d8\u05e2\u05d5\u05dd \u05de\u05d0\u05db\u05dc\u05d9\u05dd \u05e9\u05d5\u05d5\u05d9\u05d9\u05e6\u05e8\u05d9\u05d9\u05dd \u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05d9\u05dd \u05d5\u05d7\u05d5\u05d5\u05d9\u05d4 \u05e7\u05d5\u05dc\u05d9\u05e0\u05e8\u05d9\u05ea \u05de\u05e7\u05d5\u05de\u05d9\u05ea."}]}}]}},"ar":{"ai_text_about_the_country":{"sections":[{"layout":"text_country","data":{"title":"\u0632\u064a\u0648\u0631\u062e: \u0645\u0632\u064a\u062c \u0633\u0627\u062d\u0631 \u0628\u064a\u0646 \u0627\u0644\u062d\u062f\u0627\u062b\u0629 \u0648\u062c\u0645\u0627\u0644 \u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0633\u0648\u064a\u0633\u0631\u064a\u0629","text":"<p>\u062a\u064f\u0639\u062f \u0632\u064a\u0648\u0631\u062e\u060c \u0643\u0628\u0631\u0649 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0633\u0648\u064a\u0633\u0631\u064a\u0629\u060c \u0645\u0632\u064a\u062c\u0627\u064b \u0641\u0631\u064a\u062f\u0627\u064b \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u062d\u064a\u0648\u064a\u0629 \u0627\u0644\u0639\u0635\u0631 \u0627\u0644\u062d\u062f\u064a\u062b \u0648\u062c\u0645\u0627\u0644 \u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u062e\u0644\u0627\u0628. \u0628\u0645\u0648\u0642\u0639\u0647\u0627 \u0627\u0644\u0641\u0631\u064a\u062f \u0639\u0644\u0649 \u0636\u0641\u0627\u0641 \u0628\u062d\u064a\u0631\u0629 \u0632\u064a\u0648\u0631\u062e \u0627\u0644\u0633\u0627\u062d\u0631\u0629\u060c \u0648\u062a\u062d\u064a\u0637 \u0628\u0647\u0627 \u0642\u0645\u0645 \u062c\u0628\u0627\u0644 \u0627\u0644\u0623\u0644\u0628 \u0627\u0644\u0634\u0627\u0647\u0642\u0629\u060c \u062a\u0639\u062f \u0632\u064a\u0648\u0631\u062e \u0646\u0642\u0637\u0629 \u0627\u0646\u0637\u0644\u0627\u0642 \u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0631\u0648\u0639\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0641\u064a \u0627\u0644\u0647\u0648\u0627\u0621 \u0627\u0644\u0637\u0644\u0642. \u0634\u0648\u0627\u0631\u0639\u0647\u0627 \u0627\u0644\u0645\u0631\u0635\u0648\u0641\u0629 \u0628\u0627\u0644\u062d\u0635\u0649 \u062a\u062d\u0643\u064a \u0642\u0635\u0635\u0627\u064b \u0645\u0646 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u060c \u0648\u062a\u0646\u0628\u0636 \u0628\u062a\u0646\u0648\u0639 \u062b\u0642\u0627\u0641\u064a \u063a\u0646\u064a. \u0645\u0646 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0644\u0627\u062a \u0627\u0644\u0646\u0627\u0628\u0636\u0629 \u0628\u0627\u0644\u062d\u064a\u0627\u0629 \u0643\u0645\u0647\u0631\u062c\u0627\u0646 'Sechselauten' \u0627\u0644\u0634\u0647\u064a\u0631\u060c \u0625\u0644\u0649 \u0643\u0646\u0648\u0632\u0647\u0627 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0645\u0646 \u0645\u062a\u0627\u062d\u0641 \u0648\u0645\u0639\u0627\u0644\u0645 \u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0639\u0631\u064a\u0642\u0629 \u0645\u062b\u0644 \u0643\u0646\u064a\u0633\u0629 \u063a\u0631\u0648\u0633\u0645\u0646\u0633\u062a\u0631\u060c \u062a\u0642\u062f\u0645 \u0632\u064a\u0648\u0631\u062e \u062a\u062c\u0631\u0628\u0629 \u0644\u0627 \u062a\u064f\u0646\u0633\u0649 \u062a\u062b\u0631\u064a \u0630\u0627\u0643\u0631\u0629 \u0643\u0644 \u0632\u0627\u0626\u0631.<\/p><p>\u062a\u064f\u0639\u062f \u0632\u064a\u0648\u0631\u062e \u0648\u062c\u0647\u0629 \u0631\u0627\u0626\u0639\u0629 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0627\u0644\u0628\u0627\u062d\u062b\u0629 \u0639\u0646 \u062a\u062c\u0627\u0631\u0628 \u0645\u0645\u062a\u0639\u0629. \u064a\u0645\u0643\u0646 \u0644\u0644\u0623\u0637\u0641\u0627\u0644 \u0627\u0644\u0627\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u062c\u0648\u0644\u0627\u062a \u0645\u0645\u064a\u0632\u0629 \u0641\u064a \u0645\u062a\u062d\u0641 \u0627\u0644\u0634\u0648\u0643\u0648\u0644\u0627\u062a\u0629 '\u0644\u0646\u062a' (Lindt Home of Chocolate)\u060c \u062d\u064a\u062b \u062a\u064f\u0642\u062f\u0645 \u062a\u062c\u0631\u0628\u0629 \u062a\u0641\u0627\u0639\u0644\u064a\u0629 \u0634\u064a\u0642\u0629\u060c \u0641\u0636\u0644\u0627\u064b \u0639\u0646 \u0627\u0644\u0623\u0631\u0627\u062c\u064a\u062d \u0648\u0627\u0644\u0645\u0633\u0627\u062d\u0627\u062a \u0627\u0644\u0644\u0639\u0628 \u0627\u0644\u0645\u0645\u062a\u0639\u0629 \u0627\u0644\u0645\u0646\u062a\u0634\u0631\u0629 \u062d\u0648\u0644 \u0628\u062d\u064a\u0631\u0629 \u0632\u064a\u0648\u0631\u062e. \u0647\u0630\u0627 \u0627\u0644\u062a\u0646\u0648\u0639 \u0628\u064a\u0646 \u0627\u0644\u062c\u0645\u0627\u0644 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u064a\u062e\u0644\u0642 \u0623\u062c\u0648\u0627\u0621\u064b \u0631\u0627\u0626\u0639\u0629 \u062a\u064f\u0646\u0627\u0633\u0628 \u062c\u0645\u064a\u0639 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0639\u0627\u0626\u0644\u0629\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644 \u0632\u064a\u0648\u0631\u062e \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u0623\u0645\u062b\u0644 \u0644\u0647\u0645.<\/p>","image":null,"text_2":"<p>\u064a\u064f\u0639\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0632\u064a\u0648\u0631\u062e \u0648\u0627\u0644\u062a\u0646\u0642\u0644 \u062f\u0627\u062e\u0644\u0647\u0627 \u0623\u0645\u0631\u0627\u064b \u0633\u0644\u0633\u0627\u064b \u0648\u0645\u0631\u064a\u062d\u0627\u064b \u0644\u0644\u063a\u0627\u064a\u0629. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0648\u0635\u0648\u0644 \u0645\u0646 \u0645\u0637\u0627\u0631 \u0632\u064a\u0648\u0631\u062e \u0625\u0644\u0649 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0628\u0633\u0647\u0648\u0644\u0629 \u062a\u0627\u0645\u0629 \u0628\u0648\u0627\u0633\u0637\u0629 \u0627\u0644\u0642\u0637\u0627\u0631\u060c \u0641\u064a \u0631\u062d\u0644\u0629 \u0644\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 15 \u062f\u0642\u064a\u0642\u0629. \u0639\u0644\u0627\u0648\u0629 \u0639\u0644\u0649 \u0630\u0644\u0643\u060c \u062a\u062a\u0645\u062a\u0639 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0628\u0646\u0638\u0627\u0645 \u0646\u0642\u0644 \u0639\u0627\u0645 \u0645\u062a\u0637\u0648\u0631 \u0648\u0645\u0645\u062a\u0627\u0632\u060c \u064a\u0633\u0647\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0643\u0627\u0641\u0629 \u0645\u0639\u0627\u0644\u0645\u0647\u0627 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0628\u0633\u0647\u0648\u0644\u0629.<\/p><p>\u064a\u064f\u0646\u0635\u062d \u0628\u0632\u064a\u0627\u0631\u0629 \u0632\u064a\u0648\u0631\u062e \u0644\u0645\u062f\u0629 \u064a\u0648\u0645\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0623\u0628\u0631\u0632 \u0645\u0627 \u062a\u0642\u062f\u0645\u0647 \u0627\u0644\u0645\u062f\u064a\u0646\u0629. \u064a\u064f\u0641\u0636\u0644 \u062a\u062c\u0646\u0628 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u062e\u0644\u0627\u0644 \u0641\u0635\u0644 \u0627\u0644\u0634\u062a\u0627\u0621 \u0627\u0644\u0642\u0627\u0631\u0633\u060c \u062d\u064a\u062b \u062a\u0634\u0647\u062f \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0646\u062e\u0641\u0627\u0636\u0627\u064b \u0645\u0644\u062d\u0648\u0638\u0627\u064b\u060c \u0641\u064a\u0645\u0627 \u064a\u064f\u0639\u062f \u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u062e\u0631\u064a\u0641 \u0623\u0641\u0636\u0644 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0644\u0644\u0627\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u062c\u0645\u0627\u0644\u0647\u0627. \u0644\u0627 \u062a\u0646\u0633\u064e \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062c\u062f\u0648\u0644 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629\u060c \u0625\u0630 \u062a\u0633\u062a\u0636\u064a\u0641 \u0632\u064a\u0648\u0631\u062e \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0630\u0647\u0644\u0629 \u0645\u